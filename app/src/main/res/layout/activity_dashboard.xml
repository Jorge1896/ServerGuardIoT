<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/dashboardRoot" xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:fillViewport="true" android:background="#101827">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:padding="22dp" android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="SERVERGUARD IoT · UNIDAD 3" android:textSize="23sp"
   android:textStyle="bold" android:textColor="#38BDF8"/>
  <TextView android:id="@+id/txtFirebase" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Firebase: conectando..."
   android:textColor="#FBBF24" android:layout_marginTop="12dp"/>
  <TextView android:id="@+id/txtEsp32" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="ESP32: sin verificar"
   android:textColor="#FBBF24"/>
  <TextView android:id="@+id/txtFechaMedicion" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Última telemetría: sin datos"
   android:textColor="#94A3B8" android:layout_marginTop="8dp"/>
  <TextView android:id="@+id/txtTemperatura" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Temperatura: -- °C"
   android:textSize="24sp" android:textColor="#FFFFFF" android:layout_marginTop="20dp"/>
  <TextView android:id="@+id/txtHumedad" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Humedad: -- %"
   android:textSize="24sp" android:textColor="#FFFFFF"/>
  <TextView android:id="@+id/txtRack" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Rack: sin datos"
   android:textSize="18sp" android:textColor="#FFFFFF" android:layout_marginTop="14dp"/>
  <TextView android:id="@+id/txtVentilador" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Ventilador: sin datos"
   android:textSize="18sp" android:textColor="#FFFFFF"/>
  <TextView android:id="@+id/txtOtros" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="LED: -- | Alarma: --"
   android:textColor="#CBD5E1"/>
  <TextView android:id="@+id/txtAlerta" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Esperando telemetría"
   android:textColor="#FBBF24" android:layout_marginTop="10dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="TEMPERATURAS CONFIGURABLES" android:textSize="18sp"
   android:textColor="#38BDF8" android:textStyle="bold" android:layout_marginTop="22dp"/>
  <EditText android:id="@+id/editMin" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:hint="Temperatura mínima (°C)"
   android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"
   android:textColorHint="#94A3B8"/>
  <EditText android:id="@+id/editMax" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:hint="Temperatura máxima (°C)"
   android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"
   android:textColorHint="#94A3B8"/>
  <Button android:id="@+id/btnGuardar" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="GUARDAR LÍMITES"/>
  <TextView android:id="@+id/txtLimites" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="Límites: aún no consultados"
   android:textColor="#CBD5E1"/>
  <Button android:id="@+id/btnControlRemoto" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="IR A CONTROL REMOTO"
   android:layout_marginTop="18dp"/>
  <Button android:id="@+id/btnHistorial" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="VER HISTORIAL DE MEDICIONES"
   android:layout_marginTop="18dp"/>
  <Button android:id="@+id/btnCerrarSesion" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:text="CERRAR SESIÓN"/>
 </LinearLayout>
</ScrollView>
